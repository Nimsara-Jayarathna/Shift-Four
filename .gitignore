# ============================================================================
# Shift-Four - Unity .gitignore
# Keep this file at the repository root (same level as Assets/, Packages/,
# ProjectSettings/, README.md, etc.).
# ============================================================================

# --- Unity generated folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Unity / IDE generated project files ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Unity crash / diagnostic files ---
sysinfo.txt
crashlytics-build.properties

# --- Build artifacts / exported packages ---
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.dmg
*.pkg

# --- Android / Gradle generated data ---
.gradle/

# --- Visual Studio / VS Code ---
.vs/
.vscode/

# --- JetBrains Rider / IntelliJ ---
.idea/
*.sln.iml

# Rider plugin generated by Unity (when present)
/Assets/Plugins/Editor/JetBrains*

# --- Consulo ---
.consulo/

# --- Blender backup files ---
*.blend1
*.blend2

# --- OS generated files ---
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# --- Temporary / editor files ---
*~
*.swp
*.swo

# ---------------------------------------------------------------------------
# IMPORTANT: DO NOT ignore these Unity project folders/files:
#   Assets/
#   Packages/
#   ProjectSettings/
#   *.meta
# They are required so every team member gets the same project configuration.
# ---------------------------------------------------------------------------


# Unity generated files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity generated assets
/Assets/AssetStoreTools*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/

# IDE and editor
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Crash dumps and temporary files
sysinfo.txt
*.tmp
*.bak
*.log

# Blender backups (keep .blend files)
*.blend1
*.blend2

# Never ignore Unity metadata!
!*.meta
