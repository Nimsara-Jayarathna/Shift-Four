# Normalize cross-platform source and Unity YAML files to LF in Git.
# Developers may use either LF or CRLF locally without noisy line-ending diffs.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
*.obj text eol=lf
*.mtl text eol=lf
*.blend binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.dll binary
*.unitypackage binary
